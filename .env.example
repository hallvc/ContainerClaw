# ContainerClaw .env example
# Copy this file to .env and fill in your values.
# Lines starting with # are comments.
#
# Precedence: shell env vars > .env file > config.json > defaults

# ── Required ──────────────────────────────────────────────
OPENROUTER_API_KEY=

# ── Slack (optional — at least one channel required) ──────
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
# SLACK_GROUP_POLICY=mention

# ── Telegram (optional) ──────────────────────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOW_FROM=

# ── AgentMail email channel (optional) ───────────────────
# AGENTMAIL_API_KEY=
# AGENTMAIL_INBOX_ID=
# AGENTMAIL_USERNAME=
# AGENTMAIL_DOMAIN=
# AGENTMAIL_POLL_INTERVAL=15
# AGENTMAIL_POLICY=open

# ── Exa (optional — enables direct API tools) ────────────
# EXA_API_KEY=

# ── Model selection (optional) ───────────────────────────
# CONTAINERCLAW_MODEL=minimax/minimax-m2.5
# CONTAINERCLAW_MODEL_CHAT=
# CONTAINERCLAW_MODEL_MEMORY=
# CONTAINERCLAW_MODEL_VISION=
# CONTAINERCLAW_MODEL_IMAGE=google/gemini-2.5-flash-image
# CONTAINERCLAW_MODEL_TTS=
# CONTAINERCLAW_MODEL_HEARTBEAT=openrouter/free

# ── Agent tuning (optional) ──────────────────────────────
# CONTAINERCLAW_TEMPERATURE=0.7
# CONTAINERCLAW_MAX_TOKENS=4096
# CONTAINERCLAW_MEMORY_WINDOW=50
# CONTAINERCLAW_MAX_ITERATIONS=20

# ── Heartbeat (optional) ─────────────────────────────────
# CONTAINERCLAW_HEARTBEAT_ENABLED=true
# CONTAINERCLAW_HEARTBEAT_INTERVAL=60

# ── Paths (optional) ─────────────────────────────────────
# CONTAINERCLAW_CONFIG_PATH=
# CONTAINERCLAW_DOTENV_PATH=
# CONTAINERCLAW_WORKSPACE=
# CONTAINERCLAW_DATA_DIR=

# ── Object Storage (S3-compatible) ──────────────────────
# Local dev uses RustFS (included in docker-compose)
# Production: use Cloudflare R2 or any S3-compatible service
# S3_ENDPOINT=http://rustfs:9000
# S3_REGION=us-east-1
# S3_BUCKET=containerclaw
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_PUBLIC_URL=http://localhost:9000
#
# Cloudflare R2 example:
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=containerclaw
# S3_ACCESS_KEY_ID=<r2-access-key>
# S3_SECRET_ACCESS_KEY=<r2-secret-key>
# S3_PUBLIC_URL=https://<custom-domain-or-r2-dev-url>
