# ContainerClaw .env example
# Copy this file to .env and fill in your values.
# Lines starting with # are comments.
#
# Precedence: shell env vars > .env file > config.json > defaults

# ── Required ──────────────────────────────────────────────
OPENROUTER_API_KEY=

# ── Slack (optional — at least one channel required) ──────
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
# SLACK_GROUP_POLICY=mention

# ── Telegram (optional) ──────────────────────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOW_FROM=

# ── AgentMail email channel (optional) ───────────────────
# AGENTMAIL_API_KEY=
# AGENTMAIL_INBOX_ID=
# AGENTMAIL_USERNAME=
# AGENTMAIL_DOMAIN=
# AGENTMAIL_POLL_INTERVAL=15
# AGENTMAIL_POLICY=open

# ── Web search (optional) ────────────────────────────────
# BRAVE_API_KEY=

# ── Model selection (optional) ───────────────────────────
# NANOBOT_MODEL=minimax/minimax-m2.5
# NANOBOT_MODEL_CHAT=
# NANOBOT_MODEL_MEMORY=

# ── Agent tuning (optional) ──────────────────────────────
# NANOBOT_TEMPERATURE=0.7
# NANOBOT_MAX_TOKENS=4096
# NANOBOT_MEMORY_WINDOW=50
# NANOBOT_MAX_ITERATIONS=20

# ── Heartbeat (optional) ─────────────────────────────────
# NANOBOT_HEARTBEAT_ENABLED=true
# NANOBOT_HEARTBEAT_INTERVAL=1800

# ── Paths (optional) ─────────────────────────────────────
# NANOBOT_CONFIG_PATH=
# NANOBOT_DOTENV_PATH=
# NANOBOT_WORKSPACE=
# NANOBOT_DATA_DIR=
