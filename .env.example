# ContainerClaw .env example
# Copy this file to .env and fill in your values.
# Lines starting with # are comments.
#
# Precedence: shell env vars > .env file > config.json > defaults

# ── Required ──────────────────────────────────────────────
OPENROUTER_API_KEY=

# ── Slack (optional — at least one channel required) ──────
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
# SLACK_GROUP_POLICY=mention

# ── Telegram (optional) ──────────────────────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOW_FROM=

# ── AgentMail email channel (optional) ───────────────────
# AGENTMAIL_API_KEY=
# AGENTMAIL_INBOX_ID=
# AGENTMAIL_USERNAME=
# AGENTMAIL_DOMAIN=
# AGENTMAIL_POLL_INTERVAL=15
# AGENTMAIL_POLICY=open

# ── Model selection (optional) ───────────────────────────
# CONTAINERCLAW_MODEL=minimax/minimax-m2.5
# CONTAINERCLAW_MODEL_CHAT=
# CONTAINERCLAW_MODEL_MEMORY=

# ── Agent tuning (optional) ──────────────────────────────
# CONTAINERCLAW_TEMPERATURE=0.7
# CONTAINERCLAW_MAX_TOKENS=4096
# CONTAINERCLAW_MEMORY_WINDOW=50
# CONTAINERCLAW_MAX_ITERATIONS=20

# ── Heartbeat (optional) ─────────────────────────────────
# CONTAINERCLAW_HEARTBEAT_ENABLED=true
# CONTAINERCLAW_HEARTBEAT_INTERVAL=1800

# ── Paths (optional) ─────────────────────────────────────
# CONTAINERCLAW_CONFIG_PATH=
# CONTAINERCLAW_DOTENV_PATH=
# CONTAINERCLAW_WORKSPACE=
# CONTAINERCLAW_DATA_DIR=
